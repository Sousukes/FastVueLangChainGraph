# ===== DeepSeek（默认，阶段 00–17 使用）=====
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认模型；具体 id 以动笔时 DeepSeek 平台实际值为准
DEEPSEEK_MODEL=deepseek-flash

# ===== Claude（仅阶段 18 Computer Use 使用，方案 A 唯一例外）=====
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com/v1

# ===== 阶段 07 起：嵌入模型下载（可选）=====
# FastEmbed 首次运行需从 HuggingFace 下载约 90MB 权重。
# 国内网络不通时取消下面这行的注释，改用镜像：
# HF_ENDPOINT=https://hf-mirror.com
